# Copy to .env.local and fill in. Never commit .env.local.

# Frontend only: 1 = run the UI on mock data without backend or Supabase.
NEXT_PUBLIC_MOCK_API=

# Public, used by the browser for feedback/waitlist inserts (RLS allows insert only).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only, used by app/api/analyze. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
IP_HASH_SALT=
# Empty = backend demo mode without an AI call.
LLM_API_KEY=
